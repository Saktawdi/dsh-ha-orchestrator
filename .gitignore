dsh-ha-orchestrator.ha.json
dsh-ha-orchestrator.runs.jsonl
# 每 run 调研工件 markdown（recordRun 时生成，与 runs.jsonl 同目录）
dsh-ha-orchestrator.run-*.md
ha-orchestrator.config.json
ha-orchestrator.config.backup.json
ha-orchestrator.ha.json
ha-orchestrator.runs.jsonl

