{
  "name": "ha-orchestrator",
  "version": "0.2.2",
  "description": "Model high-availability failover + subagent orchestration (fanout/pipeline/supervisor) for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "high-availability",
    "failover",
    "orchestration",
    "subagents"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    ".language",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/language.js && node --check lib/config.js && node --check lib/ha-core.js && node --check lib/orch-runner.js && node --check lib/remote.js",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "npm run check && npm test && npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Saktawdi/ha-orchestrator.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
